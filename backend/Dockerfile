# Backend — FastAPI + scikit-learn
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# System deps kept minimal; scikit-learn/scipy/numpy ship wheels for slim images.
RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

# Data + artifacts are regenerated by the entrypoint if not provided via volumes.
RUN mkdir -p data artifacts

EXPOSE 8000

# Download dataset + train if artifacts are missing, then serve.
CMD ["sh", "-c", "if [ ! -f artifacts/model_metadata.json ]; then python -m scripts.download_data && python -m scripts.train_models; fi && uvicorn app.main:app --host 0.0.0.0 --port 8000"]
