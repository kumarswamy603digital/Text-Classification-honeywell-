# Copy this file to .env and adjust values as needed.
# .env is git-ignored; never commit real secrets.

# Comma-separated list of allowed CORS origins for the frontend
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Where fitted model artifacts and metadata live (relative to backend/ or absolute)
ARTIFACTS_DIR=artifacts

# Where the raw dataset lives (relative to backend/ or absolute)
DATA_DIR=data

# Prediction limits
MAX_TEXT_LENGTH=5000
MAX_BATCH_SIZE=200

# Optional prediction history (SQLite). Set to "true" to enable.
ENABLE_HISTORY=true
HISTORY_DB_PATH=artifacts/history.db
# Store raw input text in history? Keep false unless clearly disclosed to users.
HISTORY_STORE_TEXT=false

# Uplift: also exposed via uvicorn startup in docs. Example run:
#   uvicorn app.main:app --reload --port 8000
